# SQL Server is the default backend. Copy to .env for an existing server.
# For local Codespaces development, npm run db:setup generates credentials.
DB_CLIENT=mssql
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=tradeflow
MSSQL_USER=tradeflow
MSSQL_PASSWORD=
# Local Docker development service only; the app never connects as sa.
MSSQL_SA_PASSWORD=
MSSQL_ENCRYPT=true
# Set true ONLY for the local development container's self-signed certificate.
# Production: trusted server certificate, matching hostname/IP, and false.
MSSQL_TRUST_SERVER_CERTIFICATE=false
# Fresh demo ONLY. Leave false when migrating existing business data.
MSSQL_ALLOW_INITIALIZE=false
# Existing MySQL source credentials: keep these during migration.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=tradeflow
# MYSQL_USER=tradeflow
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/ca.pem
# APP_ORIGIN=https://your-server-address
