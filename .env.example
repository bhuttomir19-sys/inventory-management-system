# Copy this file to .env for an existing database, or use npm run db:setup for Codespaces.
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tradeflow
MYSQL_USER=tradeflow
MYSQL_PASSWORD=
# Required only for the local Docker MySQL service.
MYSQL_ROOT_PASSWORD=
# Remote MySQL: enable TLS verification and optionally specify a trusted CA file.
MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/ca.pem
# APP_ORIGIN=https://your-codespace-3000.app.github.dev
