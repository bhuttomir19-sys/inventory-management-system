{
  "name": "tradeflow-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "test": "node --test tests/*.test.js",
    "db:setup": "node scripts/setup-mysql.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop mysql",
    "db:migrate": "node scripts/migrate-sqlite.js",
    "test:mysql": "node scripts/test-mysql.js",
    "db:shell": "node scripts/mysql-shell.js",
    "db:prepare": "node scripts/prepare-mysql.js"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  }
}
